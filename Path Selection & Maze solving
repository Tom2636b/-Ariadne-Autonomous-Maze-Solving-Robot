  if (!SERIAL_DEBUG) {
    return;
  }

  float wallGuideErrorCm = wallAlignPossible() ? wallAlignErrorCm() : 0.0f;
  int wallGuideSign = signWithDeadband(wallGuideErrorCm, HEADING_WALL_GUIDE_DEADBAND_CM);
  float headingErrorDeg = normalizeAngle(headingTargetDegrees - yawDegrees);

  unsigned long now = millis();
  if (now - lastDebugPrint < 250) {
    return;
  }
  lastDebugPrint = now;

  Serial.print(F("Rule="));
