void setup() {
  Serial.begin(115200);

  pinMode(FRONT_TRIG_PIN, OUTPUT);
  pinMode(FRONT_ECHO_PIN, INPUT);
  pinMode(RIGHT_TRIG_PIN, OUTPUT);
  pinMode(RIGHT_ECHO_PIN, INPUT);
  pinMode(BACK_TRIG_PIN, OUTPUT);
  pinMode(BACK_ECHO_PIN, INPUT);
  pinMode(LEFT_TRIG_PIN, OUTPUT);
  pinMode(LEFT_ECHO_PIN, INPUT);

  pinMode(BUTTON_LEFT_PIN, INPUT_PULLUP);
  pinMode(BUTTON_RIGHT_PIN, INPUT_PULLUP);

  servoForward1.attach(SERVO_FORWARD_1_PIN);
  servoForward2.attach(SERVO_FORWARD_2_PIN);
  servoSide1.attach(SERVO_SIDE_1_PIN);
  servoSide2.attach(SERVO_SIDE_2_PIN);
  stopAllServos();

  initMpu6050();
  calibrateGyro();
  refreshSensorsIfNeeded();

  if (SERIAL_DEBUG) {
    Serial.println(F("Maze solver ready."));
    Serial.println(F("Press A0 button for LHR or A1 button for RHR."));
    Serial.println(F("Hold both buttons for Run 3 fastest route after learning."));
  }
}

void loop() {
  updateGyro();
  refreshSensorsIfNeeded();
  maybeReanchorHeading();
  printDebugIfNeeded();

  if (robotState == STATE_WAIT_FOR_RULE || robotState == STATE_FASTEST_DONE) {
    stopAllServos();
    maybeSelectRule();
    return;
  }

  switch (robotState) {
    case STATE_ENTRY_FIND_SIDE_WALLS:
      runEntryFindSideWallsState();
      break;

    case STATE_ENTRY_AUTO_ALIGN:
      runEntryAutoAlignState();
      break;

    case STATE_DRIVE:
      runDriveState();
      break;

    case STATE_COMMIT_MOVE:
      runCommitMoveState();
      break;

    case STATE_HEADING_CORRECT:
      runHeadingCorrection();
      break;

    case STATE_FASTEST_DONE:
      stopAllServos();
      break;

    case STATE_WAIT_FOR_RULE:
    default:
      break;
  }
}
