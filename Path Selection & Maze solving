void continueAfterAutoAlignTimeout() {
  bool frontBlocked = isFrontBlocked(relativeForwardSafetyDistance());

  if (autoAlignResetGyroAfter) {
    autoAlignFinishState = frontBlocked ? STATE_COMMIT_MOVE : STATE_DRIVE;
    if (frontBlocked) {
      if (!selectNextHeadingForDecision(autoAlignFinishHeading)) {
        return;
      }
    } else {
      autoAlignFinishHeading = BODY_FRONT;
    }
  } else if (autoAlignFinishState == STATE_COMMIT_MOVE) {
    if (!selectNextHeadingForDecision(autoAlignFinishHeading)) {
      return;
    }
  }

  if (autoAlignResetGyroAfter) {
    mazeSolveStartedAt = millis();
    resetMazeExitDetection();
  }

  softStop();
  clearActiveCorrection();
  resetMotionControllers();
  resetSideCorrectionConfirmation();
  resetHeadingTrimProgress();
  resetPid(entryAlignPid);
  entryAlignedSince = 0;
  entryAlignPhase = ENTRY_ALIGN_SETTLE;
  entryAlignPhaseUntil = 0;
  entryAlignDirectionSign = 0;
  entryAlignMoveDirection = autoAlignFinishHeading;
  nextAutoAlignForwardNudgeAt = 0;
  headingStableSince = 0;
  correctionStartErrorDeg = 0.0f;
  sideWallsSeenSince = 0;
  logicalHeading = autoAlignFinishHeading;
  pendingHeading = logicalHeading;
  stateStartedAt = millis();
  robotState = autoAlignFinishState;

  if (SERIAL_DEBUG) {
    Serial.print(F("Auto-align timeout. Continuing "));
    Serial.print(bodyDirName(logicalHeading));
    Serial.println(F(" and correcting while moving."));
  }
}

void maybeSelectRule() {
  static unsigned long leftPressedAt = 0;
  static unsigned long rightPressedAt = 0;
  static unsigned long bothPressedAt = 0;

  bool leftPressed = digitalRead(BUTTON_LEFT_PIN) == LOW;
  bool rightPressed = digitalRead(BUTTON_RIGHT_PIN) == LOW;
  bool bothPressed = leftPressed && rightPressed;
  unsigned long now = millis();

  if (bothPressed) {
    leftPressedAt = 0;
    rightPressedAt = 0;

    if (bothPressedAt == 0) {
      bothPressedAt = now;
    }

    if (now - bothPressedAt >= BUTTON_DEBOUNCE_MS) {
      updateFinalPathFromStoredRuns();

      if (finalPathValid) {
        fastestRunPath = finalPath;
        selectedRule = RULE_RIGHT;
        fastestPathActive = true;
        pathLearningActive = false;
        currentLearningRunSlot = 0;
      } else if (SERIAL_DEBUG) {
        Serial.println(F("No completed run path yet. Finish Run 1/Run 2 first."));
      }
    }
    if (selectedRule == RULE_NONE) {
      return;
    }
  } else {
    bothPressedAt = 0;

    if (leftPressed) {
      if (leftPressedAt == 0) {
        leftPressedAt = now;
      }
      if (now - leftPressedAt >= BUTTON_DEBOUNCE_MS) {
        selectedRule = RULE_LEFT;
        fastestPathActive = false;
        pathLearningActive = true;
        fastestRunPath = "";
        currentLearningRunSlot = nextLearningRunSlot();
        path = "";
      }
    } else {
      leftPressedAt = 0;
    }

    if (rightPressed) {
      if (rightPressedAt == 0) {
        rightPressedAt = now;
      }
      if (now - rightPressedAt >= BUTTON_DEBOUNCE_MS) {
        selectedRule = RULE_RIGHT;
        fastestPathActive = false;
        pathLearningActive = true;
        fastestRunPath = "";
        currentLearningRunSlot = nextLearningRunSlot();
        path = "";
      }
    } else {
      rightPressedAt = 0;
    }
  }

  if (selectedRule != RULE_NONE) {
    logicalHeading = BODY_FRONT;
    pendingHeading = BODY_FRONT;
    robotState = STATE_ENTRY_FIND_SIDE_WALLS;
    headingTargetDegrees = yawDegrees;
    headingStableSince = 0;
    headingCorrectionBlockedUntil = 0;
    correctionStartErrorDeg = 0.0f;
    clearActiveCorrection();
    resetHeadingTrimProgress();
    resetMotionControllers();
    resetSideCorrectionConfirmation();
    resetPid(entryAlignPid);
    nextCenteringAllowedAt = 0;
    mazeSolveStartedAt = 0;
    resetMazeExitDetection();
    sideWallsSeenSince = 0;
    entryAlignedSince = 0;
    entryAlignPhase = ENTRY_ALIGN_SETTLE;
    entryAlignPhaseUntil = 0;
    entryAlignDirectionSign = 0;
    entryAlignMoveDirection = logicalHeading;
    nextAutoAlignForwardNudgeAt = 0;
    stateStartedAt = now;
    softStop();

    if (SERIAL_DEBUG) {
      if (fastestPathActive) {
        Serial.print(F("Run 3 selected. Fastest route: "));
        Serial.println(finalPath);
      } else {
        Serial.print(F("Rule selected: "));
        Serial.println(ruleName(selectedRule));
      }
    }
  }
}

int computeHeadingCorrectionPower(float absErrorDeg) {
  if (absErrorDeg <= HEADING_DONE_ERROR_DEG) {
    return HEADING_MIN_CORRECT_US;
  }

  float span = HEADING_HARD_ERROR_DEG - HEADING_DONE_ERROR_DEG;
  float blend = span <= 0.0f ? 1.0f : (absErrorDeg - HEADING_DONE_ERROR_DEG) / span;
  blend = clampFloat(blend, 0.0f, 1.0f);
  return HEADING_MIN_CORRECT_US + static_cast<int>((ROTATE_DRIVE_US - HEADING_MIN_CORRECT_US) * blend);
}

void runHeadingCorrection() {
  unsigned long elapsed = millis() - stateStartedAt;
  float headingErrorDeg = normalizeAngle(headingTargetDegrees - yawDegrees);

  if (fabs(headingErrorDeg) <= CORNER_GYRO_PID_TOLERANCE_DEG ||
      elapsed >= CORNER_HEADING_CORRECT_MAX_MS) {
    stopAllServos();
    resetPid(cornerGyroPid);
    activeGyroTrimUs = 0;
    beginDirectionChange(pendingHeading);
    return;
  }

  if (!runCornerGyroPidIfNeeded()) {
    beginDirectionChange(pendingHeading);
  }
}

void runEntryFindSideWallsState() {
  float forwardCm = relativeForwardSafetyDistance();

  if (forwardCm <= FRONT_HARD_STOP_CM) {
    stopAllServos();
    if (rawSideWallsVisible()) {
      beginEntryAutoAlign();
    }
    return;
  }

  if (rawSideWallsVisible()) {
    if (sideWallsSeenSince == 0) {
      sideWallsSeenSince = millis();
    }

    if (millis() - sideWallsSeenSince >= ENTRY_SIDE_WALL_CONFIRM_MS) {
      beginEntryAutoAlign();
      return;
    }
  } else {
    sideWallsSeenSince = 0;
  }

  driveForwardAxis(1, computeApproachDrivePower(BODY_FRONT, forwardCm));
}

void runEntryAutoAlignState() {
  unsigned long now = millis();
  int alignDriveUs = currentEntryAlignDriveUs();
  stopAllServos();

  if (nextAutoAlignForwardNudgeAt == 0) {
    nextAutoAlignForwardNudgeAt = now + AUTO_ALIGN_FORWARD_NUDGE_INTERVAL_MS;
  }

  if ((autoAlignResetGyroAfter || autoAlignFinishState == STATE_COMMIT_MOVE) &&
      (now - stateStartedAt >= STATIONARY_ALIGN_TIMEOUT_MS)) {
    continueAfterAutoAlignTimeout();
    return;
  }

  if (entryAlignPhase == ENTRY_ALIGN_FORWARD_NUDGE) {
    if (now < entryAlignPhaseUntil &&
        relativeForwardSafetyDistance() > AUTO_ALIGN_FORWARD_NUDGE_CLEAR_CM) {
      driveBodyDirectionWithPower(logicalHeading, AUTO_ALIGN_FORWARD_NUDGE_US);
      return;
    }

    stopAllServos();
    entryAlignPhase = ENTRY_ALIGN_SETTLE;
    entryAlignPhaseUntil = now + currentEntryAlignMeasureSettleMs();
    entryAlignDirectionSign = 0;
    entryAlignMoveDirection = logicalHeading;
    nextAutoAlignForwardNudgeAt = now + AUTO_ALIGN_FORWARD_NUDGE_INTERVAL_MS;
    return;
  }

  if (now >= nextAutoAlignForwardNudgeAt) {
    if (relativeForwardSafetyDistance() > AUTO_ALIGN_FORWARD_NUDGE_CLEAR_CM) {
      entryAlignedSince = 0;
      resetPid(entryAlignPid);
      entryAlignPhase = ENTRY_ALIGN_FORWARD_NUDGE;
      entryAlignPhaseUntil = now + AUTO_ALIGN_FORWARD_NUDGE_MS;
      entryAlignDirectionSign = 0;
      entryAlignMoveDirection = logicalHeading;
      driveBodyDirectionWithPower(logicalHeading, AUTO_ALIGN_FORWARD_NUDGE_US);

      if (SERIAL_DEBUG) {
        Serial.println(F("Auto-align taking a small forward nudge."));
      }
      return;
    }

    nextAutoAlignForwardNudgeAt = now + AUTO_ALIGN_FORWARD_NUDGE_INTERVAL_MS;
  }

  if (!positionAlignPossible()) {
    if (!autoAlignResetGyroAfter &&
        autoAlignFinishState == STATE_COMMIT_MOVE &&
        isFrontBlocked(relativeForwardSafetyDistance())) {
      if (!selectNextHeadingForDecision(autoAlignFinishHeading)) {
        return;
      }

      if (SERIAL_DEBUG) {
        Serial.print(F("Junction has no opposite walls to align against. Following rule -> "));
        Serial.println(bodyDirName(autoAlignFinishHeading));
      }

      finishAutoAlign();
      return;
    }

    entryAlignedSince = 0;
    resetPid(entryAlignPid);
    entryAlignPhase = ENTRY_ALIGN_SETTLE;
    entryAlignPhaseUntil = now + currentEntryAlignMeasureSettleMs();
    entryAlignDirectionSign = 0;
    entryAlignMoveDirection = logicalHeading;
    return;
  }

  if (entryAlignPhase == ENTRY_ALIGN_NUDGE) {
    if (now < entryAlignPhaseUntil) {
      driveBodyDirectionWithPower(entryAlignMoveDirection, alignDriveUs);
      return;
    }

    stopAllServos();
    entryAlignPhase = ENTRY_ALIGN_SETTLE;
    entryAlignPhaseUntil = now + currentEntryAlignPostNudgeMs();
    entryAlignDirectionSign = 0;
    entryAlignMoveDirection = logicalHeading;
    return;
  }

  if (now < entryAlignPhaseUntil) {
    return;
  }

  if (runCornerGyroPidIfNeeded()) {
    entryAlignedSince = 0;
    resetPid(entryAlignPid);
    return;
  }

  if (currentEntryAlignCentered()) {
    stopAllServos();
    resetPid(entryAlignPid);

    if (entryAlignedSince == 0) {
      entryAlignedSince = now;
    }

    if (now - entryAlignedSince >= currentEntryAlignHoldMs()) {
      if (autoAlignResetGyroAfter) {
        beginMazeSolveAfterEntry();
      } else {
        if (autoAlignFinishState == STATE_COMMIT_MOVE) {
          if (!selectNextHeadingForDecision(autoAlignFinishHeading)) {
            return;
          }
        }
        finishAutoAlign();
      }
    }
    return;
  }

  entryAlignedSince = 0;
  float positionErrorCm = 0.0f;
  entryAlignMoveDirection = dominantEntryAlignDirection(positionErrorCm);
  float pidOutputMs = updatePid(entryAlignPid, positionErrorCm);
  unsigned long nudgeMs = static_cast<unsigned long>(
    clampFloat(
      fabs(pidOutputMs),
      static_cast<float>(currentEntryAlignNudgeMinMs()),
      static_cast<float>(currentEntryAlignNudgeMaxMs())
    )
  );

  entryAlignDirectionSign = positionErrorCm >= 0.0f ? 1 : -1;
  entryAlignPhase = ENTRY_ALIGN_NUDGE;
  entryAlignPhaseUntil = now + nudgeMs;
  driveBodyDirectionWithPower(entryAlignMoveDirection, alignDriveUs);
}

void runDriveState() {
  float forwardCm = relativeForwardSafetyDistance();

  if (handleMazeExitIfDetected()) {
    return;
  }

  if (forwardCm <= FRONT_HARD_STOP_CM || isFrontBlocked(forwardCm)) {
    beginCornerHeadingCorrect();
    return;
  }

  if (handleSideWallEmergency()) {
    return;
  }

  driveRelativeMotionWithCorrections(
    logicalHeading,
    computeApproachDrivePower(logicalHeading, forwardCm),
    computeDriveLateralSignedUs(forwardCm),
    computeDriveRotateTrimSignedUsForHeading(logicalHeading)
  );
}

void runCommitMoveState() {
  unsigned long elapsed = millis() - stateStartedAt;
  float forwardCm = relativeForwardSafetyDistance();

  if (handleMazeExitIfDetected()) {
    return;
  }

  if (forwardCm <= FRONT_HARD_STOP_CM) {
    beginCornerHeadingCorrect();
    return;
  }

  if (elapsed >= MIN_DIRECTION_CHANGE_MS && isFrontBlocked(forwardCm)) {
    beginCornerHeadingCorrect();
    return;
  }

  if (handleSideWallEmergency()) {
    return;
  }

  driveRelativeMotionWithCorrections(
    logicalHeading,
    computeApproachDrivePower(logicalHeading, forwardCm),
    computeDriveLateralSignedUs(forwardCm),
    computeDriveRotateTrimSignedUsForHeading(logicalHeading)
  );

  if (elapsed >= MAX_DIRECTION_CHANGE_MS) {
    clearActiveCorrection();
    resetMotionControllers();
    resetHeadingTrimProgress();
    robotState = STATE_DRIVE;
    return;
  }

  if (elapsed < MIN_DIRECTION_CHANGE_MS) {
    return;
  }

  if (corridorReadyForNewHeading() && !isFrontBlocked(relativeForwardSafetyDistance())) {
    clearActiveCorrection();
    resetMotionControllers();
    resetHeadingTrimProgress();
    robotState = STATE_DRIVE;
  }
}

